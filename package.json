{
  "name": "care-album-saver",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build",
    "test": "node --test --import ./scripts/test-env.js \"packages/care-album-saver/test/*.test.js\"",
    "clean": "tsc --build --clean && node -e \"require('node:fs').rmSync('packages/care-album-saver/dist', { recursive: true, force: true })\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.6.0"
  }
}
